{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      ".indexOn": [
        "email",
        "uid",
        "contactId",
        "idContacto"
      ]
    },
    "ordenes": {
      ".indexOn": [
        "fecha",
        "estado",
        "tipo",
        "proveedorId",
        "asignadaA",
        "createdAt",
        "updatedAt"
      ]
    },
    "proveedores": {
      ".indexOn": [
        "nombre",
        "tipo",
        "createdAt",
        "updatedAt",
        "frecuencia/tipo"
      ]
    },
    "productos": {
      ".indexOn": [
        "nombre",
        "proveedorId",
        "orden",
        "precio",
        "stock",
        "archivado",
        "createdAt",
        "updatedAt"
      ]
    }
  }
}